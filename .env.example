# Local port bound on 127.0.0.1 (matches official Colab local runtime docs: 9000)
COLAB_PORT=9000

# Optional fixed token. Leave empty to generate a fresh random token on every container start.
COLAB_TOKEN=

# Host directory mounted to /content inside the container
COLAB_WORKSPACE=./workspace

# Base NVIDIA NGC PyTorch image (ARM64 / CUDA 13.5 / Blackwell sm_121)
BASE_IMAGE=nvcr.io/nvidia/pytorch:26.11-py3

# Timezone inside the container
TZ=Asia/Tokyo
